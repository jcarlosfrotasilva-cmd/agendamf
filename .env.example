# ============================================================
# Agenda de Compromissos da Gestão Escolar
# EE PROFA. MARLENE FRATTINI  ·  Banco de dados: Supabase
# ============================================================

# IMPORTANTE: use .env.local (prioridade sobre .env) para as credenciais de produção.

# 1) Connection string do Supabase
#    Supabase → Project Settings → Database → Connection string (URI)
#    Preferencial: Session pooler (porta 5432) ou Transaction pooler (porta 6543).
SUPABASE_DB_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require

# Alternativa aceita pelo sistema (usada se SUPABASE_DB_URL não existir)
# DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres?sslmode=require

# 2) Ajustes opcionais de conexão
# PGPOOL_MAX=10
# PGCONNECT_TIMEOUT=15000

# 3) WhatsApp — DISPARO AUTOMÁTICO (opcional)
#    Com um provedor configurado, o sistema envia sozinho: convite ao agendar,
#    lembrete do despertador e aviso de alteração. Sem provedor, continua
#    funcionando pelo link direto do WhatsApp (wa.me) com histórico registrado.

# Escolha do provedor (opcional: o sistema detecta pelo primeiro com credenciais)
# WHATSAPP_PROVIDER=zapi   # meta | zapi | evolution | twilio

# --- Z-API (WhatsApp comum por QR Code — mais simples) ---
# ZAPI_INSTANCE=000000000000000
# ZAPI_TOKEN=SEU_TOKEN
# ZAPI_CLIENT_TOKEN=SEU_CLIENT_TOKEN

# --- WhatsApp Cloud API (Meta oficial; exige template aprovado) ---
# WHATSAPP_TOKEN=EAAG...token-do-app-meta
# WHATSAPP_PHONE_ID=000000000000000

# --- Evolution API (open source, auto-hospedada) ---
# EVOLUTION_URL=https://evolution.suaescola.com.br
# EVOLUTION_API_KEY=SUA_API_KEY
# EVOLUTION_INSTANCE=escola

# --- Twilio WhatsApp ---
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=+14155238886

# Comportamento do disparo automático
# WHATSAPP_AUTO_CONVITE=true      # convite sai sozinho ao agendar
# WHATSAPP_AUTO_ALTERACAO=true    # avisa alterações depois do convite
# WHATSAPP_JANELA_MINUTOS=180     # tolerância após o início do compromisso

# 4) Segurança da sessão da equipe de gestão
#    Assina os cookies de login (12 h). Defina uma string longa e aleatória.
SESSION_SECRET=TROQUE_POR_UMA_STRING_LONGA_E_ALEATORIA

# 5) Agendador do disparo automático (cron a cada 5 min)
#    Rota: /api/whatsapp/automatico?somente=todos&secret=SEU_CRON_SECRET
# CRON_SECRET=TROQUE_POR_UM_SEGREDO_LONGO

# 4) Identidade institucional (aparece no sistema, relatórios e feed iCalendar)
NEXT_PUBLIC_ESCOLA_NOME=EE PROFA. MARLENE FRATTINI
NEXT_PUBLIC_ESCOLA_NOME_COMPLETO=Escola Estadual Professora Marlene Frattini
NEXT_PUBLIC_ESCOLA_SIGLA=EE PMF
# NEXT_PUBLIC_DIRETORIA=Diretoria de Ensino — Regional
